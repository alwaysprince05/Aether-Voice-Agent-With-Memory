# ── AETHER Voice Agent — environment template ──
# Copy this file to `.env` and fill in your real keys.

# REQUIRED: Groq API key (used for the LLM and Whisper transcription).
# Get one free at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: model overrides (defaults shown)
# OPENAI_MODEL=openai/gpt-oss-120b
# OPENAI_TTS_VOICE=en
# OPENAI_WHISPER_MODEL=whisper-large-v3

# Optional: local data directory for todos/memories JSON storage
# DATA_DIR=~/.voice-agent

# Optional: MongoDB connection string for cloud persistence
# MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net
